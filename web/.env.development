# Dev-server settings, loaded by vite.config.ts (mode=development).
# Committed so a fresh clone runs with no setup. To override locally without
# touching this file, create .env.development.local — it is gitignored by *.local.

# Port `npm run dev` listens on.
DEV_SERVER_PORT=5173

# The API the dev server forwards /api/* to. Must match the .NET app's URL in
# src/BlindPaste.Api/Properties/launchSettings.json (http profile).
API_URL=http://localhost:5013

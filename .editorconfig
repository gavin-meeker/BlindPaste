root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C#
[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

# Project / config files
[*.{csproj,props,targets,xml,slnx}]
indent_size = 2

# Web / frontend
[*.{ts,tsx,js,jsx,json,css,scss,html,yml,yaml}]
indent_size = 2

# SQL changesets
[*.sql]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Env templates — the trailing-newline rule still applies, but no reformatting
[*.example]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

meta {
  name: Create burn-after-reading paste
  type: http
  seq: 3
  tags: [
    smoke
    burn
  ]
}

post {
  url: {{baseUrl}}/api/pastes
  body: json
  auth: inherit
}

body:json {
  {
    "payload": "{{freshPayload}}",
    "expiresInSeconds": 3600,
    "burnAfterReading": true
  }
}

vars:post-response {
  burnPasteId: res.body.id
}

assert {
  res.status: 201
  res.body.burnAfterReading: true
}

script:post-response {
  bru.setVar("burnPayload", bru.getVar("freshPayload"));
}

docs {
  Same endpoint, `burnAfterReading: true`. Nothing is different yet — the flag only
  changes what happens on the first read. The next two requests are the interesting half.
}
